      "type": "string",
      "default": ""
    },
    "items": {
      "type": "array",
      "default": [
        {
          "img": {
            "url": "https://templates.bplugins.com/wp-content/uploads/2025/02/p-29.png"
          },
          "name": "John Doe",
          "deg": "Developer",
          "reviewText": "It is a long-established fact that a reader will be distracted by the readable content of a page when looking at its layout",
          "rating": 5
        }
      ]
    },
    "elements": {
      "type": "object",
      "default": {
        "name": true,
        "deg": true,
        "reviewText": true
      }
    },
    "columns": {
      "type": "object",
      "default": {
        "desktop": 3,
        "tablet": 2,
        "mobile": 1
      }
    },
    "layout": {
      "type": "string",
      "default": "default"
    },
    "slider": {
      "type": "object",
      "default": {
        "autoPlay": true,
        "mouseWheel": true,
        "navigation": true
      }
    },
    "marquee": {
      "type": "object",
      "default": {
        "speed": 30,
        "direction": "left",
        "pauseOnHover": true
      }
    },
    "pauseInEditor": {
      "type": "boolean",
      "default": false
    },
    "theme": {
      "type": "string",
      "default": "theme_2"
    },
    "gradientBorder": {
      "type": "boolean",
      "default": true
