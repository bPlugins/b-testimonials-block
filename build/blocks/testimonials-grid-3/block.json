      "type": "string"
    },
    "expandedTypo": {
      "type": "object"
    },
    "expandColor": {
      "type": "string"
    },
    "expandHoverColor": {
      "type": "string"
    },
    "badgeTitle": {
      "type": "string",
      "default": ""
