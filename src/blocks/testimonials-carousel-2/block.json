{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bptmb/testimonials-carousel-2",
	"title": "Coverflow Carousel",
	"description": "Center-focused 3D coverflow carousel slider.",
	"category": "bplugins",
	"parent": [
		"bptmb/b-testimonials"
	],
	"keywords": [
		"testimonials",
		"testimonials-carousel-2"
	],
	"textdomain": "b-testimonials-block",
	"attributes": {
		"align": {
			"type": "string",
			"default": "wide"
		},
		"cId": {
			"type": "string",
			"default": ""
		},
		"items": {
			"type": "array",
			"default": [
				{
					"img": {
						"url": "https://templates.bplugins.com/wp-content/uploads/2025/02/p-29.png"
					},
					"name": "John Doe",
					"deg": "Developer",
					"reviewText": "It is a long-established fact that a reader will be distracted by the readable content of a page when looking at its layout",
					"rating": 5
				}
			]
		},
		"elements": {
			"type": "object",
			"default": {
				"name": true,
				"deg": true,
				"reviewText": true
			}
		},
		"columns": {
			"type": "object",
			"default": {
				"desktop": 3,
				"tablet": 2,
				"mobile": 1
			}
		},
		"layout": {
			"type": "string",
			"default": "slider"
		},
		"theme": {
			"type": "string",
			"default": "theme_2"
		},
		"badgeTitle": {
			"type": "string",
			"default": ""
		},
		"badgeDesc": {
			"type": "string",
			"default": ""
		},
		"badgeScore": {
			"type": "string",
			"default": ""
		},
		"badgeCount": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"html": false
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"render": "file:./render.php",
	"viewScript": "file:./view.js",
	"style": [
		"file:./index.css",
		"file:./view.css"
	]
}
