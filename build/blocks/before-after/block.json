{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "category": "bplugins",
  "parent": [
    "bptmb/b-testimonials"
  ],
  "textdomain": "b-testimonials-block",
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "html": false
  },
  "editorScript": [
    "file:./index.js"
  ],
  "editorStyle": "file:./index.css",
  "style": [
    "file:./index.css",
    "file:./view.css"
  ],
  "viewScript": [
    "file:./view.js"
  ],
  "render": "file:./render.php",
  "name": "bptmb/before-after",
  "title": "Before / After",
  "description": "An interactive before/after image comparison slider.",
  "keywords": [
    "before",
    "after",
    "comparison",
    "slider",
    "image"
  ],
  "attributes": {
    "align": {
      "type": "string",
      "default": "wide"
    },
    "cId": {
      "type": "string",
      "default": ""
    },
    "beforeImg": {
      "type": "object",
      "default": {
        "url": ""
      }
    },
    "afterImg": {
      "type": "object",
      "default": {
        "url": ""
      }
    },
    "beforeLabel": {
      "type": "string",
      "default": "Before"
    },
    "afterLabel": {
      "type": "string",
      "default": "After"
    },
    "startPosition": {
      "type": "number",
      "default": 50
    },
    "accentColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "columns": {
      "type": "object",
      "default": {
        "desktop": 3,
        "tablet": 2,
        "mobile": 1
      }
    },
    "layout": {
      "type": "string",
      "default": "before-after"
    },
    "theme": {
      "type": "string",
      "default": "default"
    },
    "items": {
      "type": "array",
      "default": [
        {
          "img": {
            "url": "https://templates.bplugins.com/wp-content/uploads/2025/02/p-29.png"
          },
          "name": "John Doe",
          "deg": "Developer",
          "reviewText": "It is a long-established fact that a reader will be distracted by the readable content of a page when looking at its layout",
          "rating": 5
        }
      ]
    },
    "badgeTitle": {
      "type": "string",
      "default": ""
    },
    "badgeDesc": {
      "type": "string",
      "default": ""
    },
    "badgeScore": {
      "type": "string",
      "default": ""
    },
    "badgeCount": {
      "type": "string",
      "default": ""
    }
  }
}