    "dataSource": {
      "type": "string",
      "default": "manual"
    },
    "query": {
      "type": "object",
      "default": {
        "number": 6,
        "orderBy": "date",
        "order": "desc"
      }
    },
    "background": {
      "type": "string",
      "default": "#0000"
    },
    "padding": {
      "type": "object",
      "default": {
        "top": "10px",
        "right": "15px",
        "bottom": "10px",
        "left": "15px"
      }
