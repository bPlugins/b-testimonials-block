<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>B Testimonials Block - Documentation</title>
  <link rel="icon" type="image/png" href="data:image/png;base64,">
  <meta name="description"
    content="Official documentation for the B Testimonials Block WordPress plugin: installation, the Testimonials post type, all 39 layout blocks, review score badges, the submission form, the NPS poll, styling, admin screens and troubleshooting.">
  <style>
    :root {
      --brand: #3b4bf0;
      --brand-dark: #2f3cc4;
      --brand-light: #eef0fe;
      --ink: #1a2036;
      --ink-soft: #3d4461;
      --muted: #6b7280;
      --faint: #9aa1b5;
      --line: #e6e8f0;
      --bg: #ffffff;
      --bg-soft: #f7f8fc;
      --code-bg: #f4f5fa;
      --code-ink: #2f3cc4;
      --green: #0e9f6e;
      --amber: #c27803;
      --red: #e02424;
      --radius: 0;
      --topbar-h: 72px;
      --sidebar-w: 300px;
      --toc-w: 260px;
      --content-max: 780px;
      font-size: 16px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      color: var(--ink-soft);
      background: var(--bg);
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
    }

    ::selection {
      background: var(--brand-light);
      color: var(--brand-dark);
    }

    /* ============ Top bar ============ */
    .topbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 200;
      height: var(--topbar-h);
      background: var(--brand);
      display: flex;
      align-items: center;
      gap: 1.5rem;
      padding: 0 2rem;
    }

    .topbar-brand {
      display: flex;
      align-items: center;
      gap: .7rem;
      color: #fff;
      text-decoration: none;
      flex-shrink: 0;
    }

    .topbar-logo {
      width: 34px;
      height: 34px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .topbar-logo svg,
    .topbar-logo img {
      width: 34px;
      height: 34px;
      display: block;
      border-radius: 8px;
      object-fit: cover;
    }

    .topbar-name {
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: .01em;
      white-space: nowrap;
    }

    .topbar-name .thin {
      /* the plugin name is ONE colour: vary weight only, never opacity */
      font-weight: 400;
      opacity: 1;
    }

    .topbar-sep {
      width: 1px;
      height: 26px;
      background: rgba(255, 255, 255, .35);
    }

    .topbar-docs {
      font-size: 1.15rem;
      font-weight: 600;
      color: #fff;
    }

    .topbar-search {
      flex: 1;
      display: flex;
      justify-content: center;
      min-width: 0;
    }

    .search-box {
      position: relative;
      width: 100%;
      max-width: 520px;
    }

    .search-box input {
      width: 100%;
      height: 46px;
      border: none;
      border-radius: 8px;
      padding: 0 3rem 0 2.7rem;
      font-size: .95rem;
      color: var(--ink);
      background: #fff;
      outline: none;
    }

    .search-box input::placeholder {
      color: var(--faint);
    }

    .search-box .s-icon {
      position: absolute;
      left: .95rem;
      top: 50%;
      transform: translateY(-50%);
      width: 17px;
      height: 17px;
      color: var(--faint);
      pointer-events: none;
    }

    .search-box kbd {
      position: absolute;
      right: .8rem;
      top: 50%;
      transform: translateY(-50%);
      border: 1px solid var(--line);
      border-radius: 5px;
      padding: .1rem .55rem;
      font-size: .8rem;
      color: var(--faint);
      font-family: inherit;
      background: #fff;
    }

    .search-results {
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      right: 0;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 10px;
      box-shadow: 0 16px 40px rgba(20, 24, 60, .14);
      max-height: 360px;
      overflow-y: auto;
      display: none;
    }

    .search-results.open {
      display: block;
    }

    .search-results a {
      display: block;
      padding: .65rem 1rem;
      text-decoration: none;
      border-bottom: 1px solid var(--line);
    }

    .search-results a:last-child {
      border-bottom: none;
    }

    .search-results a:hover,
    .search-results a.sel {
      background: var(--bg-soft);
    }

    .search-results .r-title {
      font-size: .9rem;
      font-weight: 600;
      color: var(--ink);
    }

    .search-results .r-crumb {
      font-size: .76rem;
      color: var(--faint);
    }

    .search-results .empty {
      padding: .9rem 1rem;
      font-size: .88rem;
      color: var(--muted);
    }

    .topbar-links {
      display: flex;
      align-items: center;
      gap: 1.8rem;
      flex-shrink: 0;
    }

    .topbar-links a {
      color: #fff;
      text-decoration: none;
      font-size: .95rem;
      font-weight: 500;
      opacity: .95;
      white-space: nowrap;
    }

    .topbar-links a:hover {
      opacity: 1;
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    .menu-btn {
      display: none;
      background: none;
      border: none;
      color: #fff;
      cursor: pointer;
      padding: .3rem;
    }

    .menu-btn svg {
      width: 24px;
      height: 24px;
    }

    /* ============ Layout ============ */
    .layout {
      display: flex;
      padding-top: var(--topbar-h);
      min-height: 100vh;
    }

    /* ============ Sidebar ============ */
    .sidebar {
      width: var(--sidebar-w);
      flex-shrink: 0;
      border-right: 1px solid var(--line);
      padding: 2rem 0 3rem;
      position: sticky;
      top: var(--topbar-h);
      height: calc(100vh - var(--topbar-h));
      overflow-y: auto;
      background: var(--bg);
    }

    .sidebar::-webkit-scrollbar {
      width: 5px;
    }

    .sidebar::-webkit-scrollbar-thumb {
      background: var(--line);
      border-radius: 3px;
    }

    .nav-group {
      border-bottom: 1px solid transparent;
    }

    .nav-group-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      background: none;
      border: none;
      cursor: pointer;
      padding: .8rem 1.6rem .8rem 2rem;
      font-size: .95rem;
      font-weight: 600;
      color: var(--ink);
      font-family: inherit;
      text-align: left;
    }

    .nav-group-head:hover {
      color: var(--brand);
    }

    .nav-group-head .chev {
      width: 14px;
      height: 14px;
      color: var(--faint);
      transition: transform .2s ease;
      flex-shrink: 0;
    }

    .nav-group.open .nav-group-head .chev {
      transform: rotate(90deg);
    }

    .nav-group-items {
      display: none;
      padding: 0 0 .6rem;
    }

    .nav-group.open .nav-group-items {
      display: block;
    }

    .nav-group-items a {
      display: block;
      padding: .38rem 1.6rem .38rem 2.7rem;
      font-size: .89rem;
      color: var(--muted);
      text-decoration: none;
      border-left: 2px solid transparent;
    }

    .nav-group-items a:hover {
      color: var(--brand);
    }

    .nav-group-items a.active {
      color: var(--brand);
      font-weight: 600;
      border-left-color: var(--brand);
      background: linear-gradient(90deg, var(--brand-light), transparent 85%);
    }

    /* ============ Main ============ */
    .main {
      flex: 1;
      min-width: 0;
      display: flex;
      justify-content: center;
      padding: 2.4rem 3rem 5rem;
      gap: 3rem;
    }

    .content {
      width: 100%;
      max-width: var(--content-max);
    }

    .breadcrumb {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: .55rem;
      font-size: .88rem;
      color: var(--muted);
      margin-bottom: 1.6rem;
    }

    .breadcrumb svg {
      width: 15px;
      height: 15px;
      color: var(--faint);
    }

    .breadcrumb a {
      color: var(--muted);
      text-decoration: none;
    }

    .breadcrumb a:hover {
      color: var(--brand);
    }

    .breadcrumb .bc-sep {
      color: var(--faint);
    }

    .breadcrumb .bc-current {
      color: var(--ink-soft);
    }

    .doc-article {
      display: none;
    }

    .doc-article.active {
      display: block;
      animation: fadein .18s ease;
    }

    @keyframes fadein {
      from {
        opacity: 0;
        transform: translateY(4px);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }

    .doc-article h1 {
      font-size: 2.15rem;
      line-height: 1.25;
      color: var(--ink);
      font-weight: 700;
      letter-spacing: -.015em;
      margin-bottom: 1.1rem;
    }

    .doc-article .lead {
      font-size: 1.05rem;
      margin-bottom: 1rem;
    }

    .doc-article h2 {
      font-size: 1.45rem;
      color: var(--ink);
      font-weight: 700;
      margin: 2.6rem 0 .9rem;
      letter-spacing: -.01em;
      scroll-margin-top: calc(var(--topbar-h) + 24px);
    }

    .doc-article h3 {
      font-size: 1.08rem;
      color: var(--ink);
      font-weight: 650;
      margin: 1.8rem 0 .6rem;
      scroll-margin-top: calc(var(--topbar-h) + 24px);
    }

    .doc-article p {
      margin-bottom: 1rem;
    }

    .doc-article ul,
    .doc-article ol {
      margin: 0 0 1.1rem 1.4rem;
    }

    .doc-article li {
      margin-bottom: .45rem;
    }

    .doc-article li::marker {
      color: var(--brand);
    }

    .doc-article a {
      color: var(--brand);
      text-decoration: none;
    }

    .doc-article a:hover {
      text-decoration: underline;
    }

    .doc-article strong {
      color: var(--ink);
      font-weight: 650;
    }

    .doc-article code {
      background: var(--code-bg);
      color: var(--code-ink);
      border: 1px solid var(--line);
      border-radius: 5px;
      padding: .1rem .4rem;
      font-size: .85em;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      /* a long URL or hostname must wrap, not widen the page on a phone */
      overflow-wrap: anywhere;
    }

    .codeblock {
      position: relative;
      margin: 0 0 1.2rem;
    }

    .codeblock pre {
      background: var(--code-bg);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 1rem 1.2rem;
      overflow-x: auto;
      font-size: .87rem;
      line-height: 1.6;
    }

    .codeblock pre code {
      background: none;
      border: none;
      padding: 0;
      color: var(--code-ink);
    }

    .codeblock .copy-btn {
      position: absolute;
      top: .55rem;
      right: .55rem;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 6px;
      font-size: .74rem;
      font-weight: 600;
      color: var(--muted);
      padding: .25rem .6rem;
      cursor: pointer;
      font-family: inherit;
    }

    .codeblock .copy-btn:hover {
      color: var(--brand);
      border-color: var(--brand);
    }

    .callout {
      border: 1px solid var(--line);
      border-left: 4px solid var(--brand);
      background: var(--bg-soft);
      border-radius: 8px;
      padding: .9rem 1.1rem;
      margin: 0 0 1.2rem;
      font-size: .93rem;
    }

    .callout p:last-child {
      margin-bottom: 0;
    }

    .callout .co-label {
      font-weight: 700;
      color: var(--ink);
      display: block;
      margin-bottom: .15rem;
    }

    .callout.tip {
      border-left-color: var(--green);
    }

    .callout.warn {
      border-left-color: var(--amber);
    }

    .callout.danger {
      border-left-color: var(--red);
    }

    table.doc-table {
      width: 100%;
      border-collapse: collapse;
      margin: 0 0 1.3rem;
      font-size: .89rem;
    }

    .table-wrap {
      overflow-x: auto;
      margin-bottom: 1.3rem;
    }

    .table-wrap table.doc-table {
      margin-bottom: 0;
    }

    table.doc-table th {
      text-align: left;
      background: var(--bg-soft);
      color: var(--ink);
      font-weight: 650;
      padding: .6rem .8rem;
      border: 1px solid var(--line);
      white-space: nowrap;
    }

    table.doc-table td {
      padding: .6rem .8rem;
      border: 1px solid var(--line);
      vertical-align: top;
    }

    table.doc-table td code {
      white-space: nowrap;
    }

    .badge-pro {
      display: inline-block;
      vertical-align: 2px;
      background: linear-gradient(90deg, #f59e0b, #f97316);
      color: #fff;
      font-size: .62rem;
      font-weight: 800;
      letter-spacing: .06em;
      padding: .12rem .45rem;
      border-radius: 999px;
      text-transform: uppercase;
      margin-left: .45rem;
    }

    .switch-row {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: .9rem;
      margin: 0 0 1.4rem;
      padding: .85rem 1.1rem;
      background: var(--brand-light);
      border: 1px solid #ccd2fb;
      border-radius: 10px;
    }

    .switch-label {
      font-size: .9rem;
      font-weight: 700;
      color: var(--ink);
    }

    .editor-switch {
      display: inline-flex;
      /* wrap on narrow screens: three buttons do not fit a 390px viewport */
      flex-wrap: wrap;
      max-width: 100%;
      gap: 4px;
      padding: 4px;
      border: 1px solid #ccd2fb;
      border-radius: 9px;
      background: #fff;
    }

    .editor-switch button {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      border: none;
      background: none;
      font-family: inherit;
      font-size: .88rem;
      font-weight: 700;
      color: var(--ink-soft);
      padding: .45rem 1.15rem;
      border-radius: 6px;
      cursor: pointer;
      transition: background .15s ease, color .15s ease;
    }

    .editor-switch button svg {
      width: 15px;
      height: 15px;
      flex-shrink: 0;
    }

    .editor-switch button:hover:not(.on) {
      background: var(--brand-light);
      color: var(--brand-dark);
    }

    .editor-switch button.on {
      background: var(--brand);
      color: #fff;
      box-shadow: 0 2px 8px rgba(59, 75, 240, .35);
    }

    .editor-switch button:focus-visible {
      outline: 2px solid var(--brand-dark);
      outline-offset: 2px;
    }

    body.editor-gutenberg .only-classic,
    body.editor-gutenberg .only-elementor,
    body.editor-gutenberg .hide-gutenberg,
    body.editor-classic .only-gutenberg,
    body.editor-classic .only-elementor,
    body.editor-classic .hide-classic,
    body.editor-elementor .only-gutenberg,
    body.editor-elementor .only-classic,
    body.editor-elementor .hide-elementor {
      display: none !important;
    }

    .section-hidden {
      display: none !important;
    }

    .no-support {
      border: 1px solid var(--line);
      border-left: 4px solid var(--amber);
      background: var(--bg-soft);
      border-radius: 8px;
      padding: .9rem 1.1rem;
      margin: 0 0 1.2rem;
      font-size: .93rem;
    }

    .no-support .ns-label {
      font-weight: 700;
      color: var(--ink);
      display: block;
      margin-bottom: .15rem;
    }

    .no-support p:last-child {
      margin-bottom: 0;
    }

    .media-slot {
      margin: 1.4rem 0 1.8rem;
    }

    .media-slot img,
    .media-slot video {
      display: block;
      width: 100%;
      height: auto;
      border-radius: 10px;
      border: 1px solid var(--line);
      box-shadow: 0 12px 32px rgba(20, 24, 60, .10);
    }

    .media-slot .yt-wrap {
      position: relative;
      padding-top: 56.25%;
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid var(--line);
      box-shadow: 0 12px 32px rgba(20, 24, 60, .10);
      background: #10132b;
    }

    .media-slot .yt-wrap iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }

    .media-slot figcaption {
      font-size: .82rem;
      color: var(--faint);
      text-align: center;
      margin-top: .6rem;
    }

    /* ===== Image lightbox ===== */
    .media-slot img {
      cursor: zoom-in;
      transition: box-shadow .18s ease;
    }

    .media-slot img:hover {
      box-shadow: 0 14px 38px rgba(20, 24, 60, .22);
    }

    .lightbox {
      position: fixed;
      inset: 0;
      z-index: 400;
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      padding: 3.2rem 4.5rem 2rem;
      background: rgba(12, 15, 35, .88);
      -webkit-backdrop-filter: blur(4px);
      backdrop-filter: blur(4px);
    }

    .lightbox.open {
      display: flex;
    }

    .lightbox img {
      max-width: 100%;
      max-height: calc(100vh - 8.5rem);
      object-fit: contain;
      border-radius: 8px;
      background: #fff;
      box-shadow: 0 24px 70px rgba(0, 0, 0, .5);
    }

    .lb-caption {
      color: #eef0fe;
      font-size: .92rem;
      text-align: center;
      max-width: 60ch;
      line-height: 1.5;
    }

    .lb-count {
      color: #9aa1c8;
      font-size: .8rem;
    }

    .lightbox button {
      position: absolute;
      background: rgba(255, 255, 255, .12);
      border: 1px solid rgba(255, 255, 255, .22);
      color: #fff;
      border-radius: 50%;
      width: 42px;
      height: 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background .15s ease;
    }

    .lightbox button:hover {
      background: rgba(255, 255, 255, .26);
    }

    .lightbox button:focus-visible {
      outline: 2px solid #fff;
      outline-offset: 2px;
    }

    .lightbox button svg {
      width: 20px;
      height: 20px;
    }

    .lb-close {
      top: 1.1rem;
      right: 1.4rem;
    }

    .lb-prev {
      left: 1.1rem;
      top: 50%;
      transform: translateY(-50%);
    }

    .lb-next {
      right: 1.1rem;
      top: 50%;
      transform: translateY(-50%);
    }

    .lightbox.single .lb-prev,
    .lightbox.single .lb-next {
      display: none;
    }

    body.lb-open {
      overflow: hidden;
    }

    @media (max-width: 640px) {
      .lightbox {
        padding: 3.2rem 1rem 1.5rem;
      }

      .lb-prev {
        left: .4rem;
      }

      .lb-next {
        right: .4rem;
      }
    }

    .media-ph {
      border: 2px dashed #c7cbe3;
      border-radius: 12px;
      background: var(--bg-soft);
      padding: 2.1rem 1.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: .45rem;
      text-align: center;
    }

    .media-ph .ph-icon {
      width: 36px;
      height: 36px;
      color: #aab0d0;
    }

    .media-ph .ph-label {
      font-weight: 650;
      color: var(--ink-soft);
      font-size: .92rem;
    }

    .media-ph .ph-path {
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: .76rem;
      color: var(--muted);
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: .18rem .6rem;
    }

    .media-ph .ph-hint {
      font-size: .75rem;
      color: var(--faint);
    }

    .steps {
      counter-reset: step;
      list-style: none;
      margin: 0 0 1.3rem;
    }

    .steps>li {
      counter-increment: step;
      position: relative;
      padding: 0 0 1.1rem 2.7rem;
      margin: 0;
    }

    .steps>li::before {
      content: counter(step);
      position: absolute;
      left: 0;
      top: .1rem;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: var(--brand-light);
      color: var(--brand-dark);
      font-size: .82rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .steps>li:not(:last-child)::after {
      content: "";
      position: absolute;
      left: 12.5px;
      top: 30px;
      bottom: 2px;
      width: 1px;
      background: var(--line);
    }

    .steps li ul {
      margin: .5rem 0 0 1.1rem;
      list-style: disc;
    }

    .steps li ul li {
      margin-bottom: .3rem;
      padding: 0;
    }

    .article-footer {
      margin-top: 3.2rem;
      padding-top: 1.4rem;
      border-top: 1px solid var(--line);
      display: flex;
      justify-content: space-between;
      gap: 1rem;
    }

    .pager-link {
      display: flex;
      flex-direction: column;
      gap: .15rem;
      text-decoration: none;
      max-width: 46%;
    }

    .pager-link .pl-dir {
      font-size: .78rem;
      color: var(--faint);
    }

    .pager-link .pl-title {
      font-size: .95rem;
      font-weight: 600;
      color: var(--brand);
    }

    .pager-link:hover .pl-title {
      text-decoration: underline;
    }

    .pager-link.next {
      margin-left: auto;
      text-align: right;
    }

    /* ============ TOC ============ */
    .toc {
      width: var(--toc-w);
      flex-shrink: 0;
      position: sticky;
      top: calc(var(--topbar-h) + 24px);
      align-self: flex-start;
      max-height: calc(100vh - var(--topbar-h) - 48px);
      overflow-y: auto;
      padding-left: .4rem;
    }

    .toc-title {
      font-size: 1rem;
      font-weight: 700;
      color: var(--ink);
      margin-bottom: .8rem;
    }

    .toc ul {
      list-style: none;
    }

    .toc li {
      margin-bottom: .55rem;
    }

    .toc a {
      font-size: .88rem;
      color: var(--muted);
      text-decoration: none;
      display: block;
      line-height: 1.45;
    }

    .toc a:hover {
      color: var(--brand);
    }

    .toc a.active {
      color: var(--brand);
      font-weight: 600;
    }

    .overlay {
      display: none;
      position: fixed;
      inset: var(--topbar-h) 0 0 0;
      background: rgba(15, 18, 40, .45);
      z-index: 140;
    }

    /* ============ Responsive ============ */
    @media (max-width: 1280px) {
      .toc {
        display: none;
      }

      .topbar-links {
        display: none;
      }
    }

    @media (max-width: 1024px) {
      .menu-btn {
        display: block;
      }

      .sidebar {
        position: fixed;
        left: 0;
        top: var(--topbar-h);
        bottom: 0;
        z-index: 150;
        transform: translateX(-100%);
        transition: transform .22s ease;
        box-shadow: 8px 0 28px rgba(20, 24, 60, .12);
        height: auto;
      }

      body.nav-open .sidebar {
        transform: none;
      }

      body.nav-open .overlay {
        display: block;
      }

      .main {
        padding: 1.8rem 1.4rem 4rem;
      }

      .topbar {
        padding: 0 1.1rem;
        gap: 1rem;
      }

      .topbar-sep,
      .topbar-docs {
        display: none;
      }
    }

    @media (max-width: 640px) {
      .doc-article h1 {
        font-size: 1.65rem;
      }

      .search-box kbd {
        display: none;
      }

      .topbar-name .thin {
        display: none;
      }
    }
  </style>
</head>

