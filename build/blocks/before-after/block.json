{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "category": "bplugins",
  "parent": [
    "bptmb/b-testimonials"
  ],
  "textdomain": "b-testimonials-block",
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "html": false
  },
  "editorScript": [
    "file:./index.js"
  ],
  "editorStyle": "file:./index.css",
  "style": [
    "file:./index.css",
    "file:./view.css"
  ],
  "viewScript": [
    "file:./view.js"
  ],
  "render": "file:./render.php",
  "name": "bptmb/before-after",
  "title": "Before / After",
  "description": "An interactive before/after image comparison slider.",
  "keywords": [
    "before",
    "after",
    "comparison",
    "slider",
    "image"
  ],
  "attributes": {
    "brandColor": {
      "type": "string"
    },
    "surfaceColor": {
      "type": "string"
    },
    "borderColor": {
      "type": "string"
    },
    "titleColor": {
      "type": "string"
    },
    "bodyColor": {
      "type": "string"
    },
    "mutedColor": {
      "type": "string"
    },
    "ratingColor": {
      "type": "string"
    },
    "trackColor": {
      "type": "string"
    },
    "labelBgColor": {
      "type": "string"
    },
    "labelTextColor": {
      "type": "string"
    },
    "gripIconColor": {
      "type": "string"
    },
    "align": {
      "type": "string",
      "default": "wide"
    },
    "blockWidth": {
      "type": "object",
      "default": {
        "desktop": "",
        "tablet": "",
        "mobile": ""
      }
    },
    "cardHeight": {
      "type": "object",
      "default": {
        "desktop": "",
        "tablet": "",
        "mobile": ""
      }
    },
    "cId": {
      "type": "string",
      "default": ""
    },
    "beforeImg": {
      "type": "object",
      "default": {
        "url": ""
      }
    },
    "afterImg": {
      "type": "object",
      "default": {
        "url": ""
      }
    },
    "beforeLabel": {
      "type": "string",
      "default": "Before"
    },
    "afterLabel": {
      "type": "string",
      "default": "After"
    },
    "startPosition": {
      "type": "number",
      "default": 50
    },
    "accentColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "layout": {
      "type": "string",
      "default": "before-after"
    },
    "cardMargin": {
      "type": "object",
      "default": {}
    }
  }
}