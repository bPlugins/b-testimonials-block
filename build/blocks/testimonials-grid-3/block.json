    "starBadgeSize": {
      "type": "number",
      "default": 12
    },
    "starBadgeRadius": {
      "type": "number",
      "default": 999
    },
    "headerWash": {
      "type": "boolean",
      "default": true
    },
    "headerWashStrength": {
      "type": "number",
      "default": 100
    },
    "starSize": {
      "type": "number"
    }
