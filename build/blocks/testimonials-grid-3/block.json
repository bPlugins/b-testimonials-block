    "lowLabel": {
      "type": "string",
      "default": "Not likely"
    },
    "highLabel": {
      "type": "string",
      "default": "Very likely"
    },
    "star5Count": {
      "type": "string",
      "default": ""
    },
    "star4Count": {
      "type": "string",
      "default": ""
